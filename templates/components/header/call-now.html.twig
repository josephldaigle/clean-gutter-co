{# twig template #}
<a class="text-link" href="tel:1-{{ company_phone | replace({'(': '', ') ': ''})}}">
    <table class="h-100 w-100 border-dashed border-danger p-2">
        <tbody class="p-2">
            <tr>
                <td class="align-middle text-center w-100 text-danger font-weight-bold text-uppercase shrink-font-1">Free Quotes</td>
            </tr>
            <tr>
                <td class="align-middle text-center w-100 text-danger h4 font-weight-bold text-nowrap mb-0">{{ company_phone }}</td>
            </tr>
            <tr>
                <td class="align-middle text-center w-100 text-danger text-uppercase shrink-font-2">Call or Text</td>
            </tr>
        </tbody>
    </table>
</a>